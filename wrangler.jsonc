{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osp2p-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
