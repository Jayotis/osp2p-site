{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osp2p-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "4242",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
